# Variables de entorno de raceupkc.com. Copia este archivo a .env para trabajar en local (.env no se sube a git).
# En Vercel se configuran en: proyecto raceupkc > Settings > Environment Variables.
# Nunca pongas valores reales en este archivo.

# --- Web actual ---------------------------------------------------------------------------
# ID de la hoja de Google Sheets de la temporada (resultados). Production.
RUKC_SHEET_ID=
# Token de la API de conversiones de Meta. Production.
META_CAPI_TOKEN=
# Opcional. Si no está, se usa el ID del píxel que viene en el código.
META_PIXEL_ID=
# Stripe: clave secreta (sk_test_... en desarrollo, rk_live_/sk_live_ en producción) y firma del webhook (whsec_...).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Base de datos (Neon, región UE) -----------------------------------------------------
# Rol rukc_app: lo usan las funciones de api/. Cadena con "-pooler" en el host.
# Desarrollo y Preview: rama "desarrollo" de Neon. Production: rama principal (fase 7).
DATABASE_URL=
# Rol rukc_migraciones: solo para aplicar migraciones (npm run db:migrar). Cadena directa, SIN "-pooler".
# No hace falta en Vercel mientras las migraciones se apliquen a mano.
DATABASE_URL_MIGRACIONES=

# --- Datos sensibles -----------------------------------------------------------------------
# Clave AES-256-GCM para cifrar el número de documento (DNI/NIE/pasaporte). 32 bytes en base64.
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si se pierde, los documentos cifrados no se pueden recuperar. Guárdala también fuera de Vercel.
RUKC_DATA_KEY=

# Solo en tu .env local, apuntando a la rama de desarrollo: permite activar documentos de prueba
# (npm run db:documentos-prueba). Valor: desarrollo. Nunca en Vercel ni en producción.
RUKC_ENTORNO=

# Clave AES-256-GCM de las copias de seguridad (distinta de RUKC_DATA_KEY). 32 bytes en base64, mismo comando.
# Sin ella las copias no se pueden abrir: guárdala también fuera de Vercel.
RUKC_BACKUP_KEY=

# --- Panel de administración (Better Auth) -------------------------------------------------
# Secreto para firmar sesiones. Al menos 32 caracteres aleatorios (mismo comando que arriba).
BETTER_AUTH_SECRET=
# URL pública de la web: http://localhost:4321 en local, https://raceupkc.com en producción.
BETTER_AUTH_URL=

# --- Archivos privados (Vercel Blob, almacén privado) --------------------------------------
# Lo crea Vercel al conectar el almacén al proyecto (Storage > Blob).
BLOB_READ_WRITE_TOKEN=
# Solo en local y en los tests: sin token, las fotos se guardan en esta carpeta.
RUKC_BLOB_LOCAL_DIR=

# --- Tareas programadas (Vercel Cron) ------------------------------------------------------
# Secreto que Vercel envía en la cabecera Authorization de cada tarea. Cadena aleatoria larga.
CRON_SECRET=

# --- Consumo de Neon (tarea diaria) -----------------------------------------------------------
# Clave de la API de Neon con acceso solo al proyecto RUKC (Neon → proyecto → Settings → API keys, "project-scoped").
NEON_API_KEY=
# Identificador del proyecto (Neon → Settings → General → Project ID). No es secreto.
NEON_PROJECT_ID=
# CU-horas de cómputo al mes incluidas en el plan (Free: 100). El panel avisa al pasar el 70 %.
NEON_LIMITE_CU_HORAS=100

# --- Chat de la web (api/chat.js) -----------------------------------------------------------------------------------
# Tope global de mensajes del chat (todas las IPs juntas), para limitar el gasto en Claude si el abuso llega desde
# muchas IPs. Además del límite por IP (12 cada 10 min, 60 al día). Por defecto 60 cada 10 minutos y 400 al día.
CHAT_WEB_MAX_10MIN=60
CHAT_WEB_MAX_DIA=400
