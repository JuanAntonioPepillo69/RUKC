---
// Páginas de texto: reglamento y textos legales
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props { title: string; description: string; eyebrow: string; heading: string; updated?: string }
const { title, description, eyebrow, heading, updated } = Astro.props;
---
<Base title={title} description={description}>
  <Header />
  <main class="doc">
    <header class="wrap doc__head">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="h2">{heading}</h1>
      {updated && <p class="muted">Última actualización: {updated}</p>}
      <slot name="head" />
    </header>
    <div class="wrap doc__body">
      <slot name="aside" />
      <article class="prose"><slot /></article>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .doc { padding-top: 120px; padding-bottom: clamp(64px, 8vw, 112px); }
  .doc__head { display: grid; gap: 14px; margin-bottom: clamp(32px, 5vw, 56px); }
  .doc__head .muted { margin: 0; font-size: 14px; }
  .doc__body { display: grid; grid-template-columns: minmax(0, 1fr); gap: 48px; }
  .doc__body:has(> aside) { grid-template-columns: 260px minmax(0, 1fr); }
  @media (max-width: 960px) { .doc__body:has(> aside) { grid-template-columns: minmax(0, 1fr); } }

  .prose { max-width: 760px; font-size: 16px; line-height: 1.7; color: #dcd8cf; }
  .prose :global(h2) { margin: 2.2em 0 0.6em; font-size: clamp(24px, 2.6vw, 32px); font-weight: 900; color: var(--paper); scroll-margin-top: 90px; }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(h3) { margin: 1.8em 0 0.5em; font-size: 20px; font-weight: 800; color: var(--paper); scroll-margin-top: 90px; }
  .prose :global(p) { margin: 0.8em 0; }
  .prose :global(p[id]) { scroll-margin-top: 90px; }
  .prose :global(p[id]:target) { background: rgba(212, 166, 42, 0.12); border-radius: 8px; padding: 6px 10px; margin-inline: -10px; }
  .prose :global(strong) { color: var(--paper); }
  .prose :global(a) { color: var(--gold-hi); }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.3em; }
  .prose :global(li) { margin: 0.35em 0; }
  .prose :global(.table-scroll) { margin: 1.2em 0; }
  .prose :global(.table td), .prose :global(.table th) { white-space: normal; vertical-align: top; font-size: 14px; }
  .prose :global(.table p) { margin: 0; }
</style>
