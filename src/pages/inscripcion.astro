---
// Reserva de plaza (F1 y F2). Las rondas, los cupos y los importes se piden a /api/catalogo al cargar, porque los cupos
// se abren y cierran a mano. Lo escrito se guarda como borrador (/api/solicitud) con un token en sessionStorage:
// tras 2 s sin escribir y al pasar de un bloque a otro. El pago lo prepara /api/checkout (tarjeta con Stripe o Bizum).
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, whatsappUrl } from '../config/site';
import { BIZUM, RESERVA } from '../config/reserva.js';
import { AVISO_BORRADORES_PROVISIONAL } from '../../lib/catalogo.js';
import { AVISO_MENOR, AVISO_WHATSAPP, CASILLA_NOVEDADES, TEXTOS_FORMULARIO_V2 } from '../../lib/whatsapp/textos-formulario.js';

const conBizum = Boolean(BIZUM.numero);
// Formulario v2 (fase 2 del bot): piloto menor con su tutor, aviso de WhatsApp y casilla de novedades. Se activa con la
// variable FORM_V2=true en Vercel y un nuevo despliegue; sin ella queda el formulario anterior.
const formV2 = (import.meta.env.FORM_V2 ?? process.env.FORM_V2) === 'true';
---
<Base
  title="Reserva tu plaza | Temporada 2 | RUKC"
  description={`Reserva tu plaza en la Temporada 2 de RUKC por ${RESERVA.importe} €. Paga con tarjeta${conBizum ? ' o Bizum' : ''}.`}
>
  <Header />
  <main class="res">
    <div class="wrap res__grid">
      <section class="res__intro">
        <p class="eyebrow">Temporada 2 · 2026-2027</p>
        <h1 class="h2">Reserva tu <em>plaza</em></h1>
        <p class="lead">Elige la ronda, paga la reserva y asegura tu sitio en la parrilla. Después te escribimos por WhatsApp para cerrar los detalles.</p>
        <ol class="res__steps">
          <li><span class="tnum">1</span>Elige la ronda y rellena tus datos.</li>
          <li><span class="tnum">2</span>{conBizum ? 'Paga la reserva con tarjeta en la pantalla segura de Stripe, o con Bizum.' : 'Paga la reserva con tarjeta en la pantalla segura de Stripe.'}</li>
          <li><span class="tnum">3</span>Te confirmamos la plaza por WhatsApp.</li>
        </ol>
        <p class="res__help">¿Dudas antes de reservar? <a href={whatsappUrl()} target="_blank" rel="noopener">Escríbenos por WhatsApp</a>.</p>
      </section>

      <div class="res__side">
        <p class="aviso" id="aviso">
          <span class="aviso__tag" id="aviso-tag">Texto provisional</span>
          <span id="aviso-texto">{AVISO_BORRADORES_PROVISIONAL}</span>
          <a href="/privacidad" target="_blank" rel="noopener">Más información en la política de privacidad</a>
        </p>

        <form class="card" id="reserva" novalidate data-wa={SITE.whatsapp.number} data-v2={formV2 ? TEXTOS_FORMULARIO_V2 : undefined}>
          <p class="card__notice" id="cancelado" hidden>Has vuelto sin pagar. No se ha hecho ningún cobro: puedes intentarlo de nuevo.</p>
          <div class="card__sum">
            <span>Reserva de plaza<span id="sum-ronda"></span></span>
            <strong class="tnum"><span id="importe">{RESERVA.importe}</span> €</strong>
          </div>
          <p class="card__desc" id="descuento">Se descuentan del precio de la carrera ({RESERVA.precioCarrera} €): después solo pagas {RESERVA.precioCarrera - RESERVA.importe} €.</p>
          <p class="card__notice" id="sin-rondas" hidden>Ahora mismo no hay ninguna ronda con la inscripción abierta. <a href={whatsappUrl()} target="_blank" rel="noopener">Escríbenos por WhatsApp</a> y te avisamos de la siguiente.</p>

          <fieldset class="paso" data-paso="1">
            <label class="field"><span>Ronda</span>
              <select name="ronda" required>
                <option value="" disabled selected>Cargando rondas…</option>
              </select>
            </label>
            <label class="field"><span>Categoría</span>
              <select name="categoria" required>
                <option value="" disabled selected>Elige una opción</option>
                <option value="LIG">Ligeros</option>
                <option value="PES">Pesados</option>
                <option value="no_se">Aún no lo sé</option>
              </select>
              <small>La categoría depende del peso con el equipo. Si dudas, elige "Aún no lo sé" y lo vemos contigo.</small>
              <small class="cupo" id="cupo" hidden></small>
            </label>
          </fieldset>

          <fieldset class="paso" data-paso="2">
            <label class="field"><span>Nombre y apellidos</span>
              <input name="nombre" type="text" autocomplete="name" required maxlength="80" />
            </label>
            <label class="field"><span>Correo electrónico</span>
              <input name="email" type="email" inputmode="email" autocomplete="email" required maxlength="120" />
            </label>
            <label class="field"><span>WhatsApp</span>
              <input name="telefono" type="tel" inputmode="tel" autocomplete="tel" placeholder="+34 600 00 00 00" required maxlength="30" />
            </label>
            <label class="check">
              <input name="otra" type="checkbox" />
              <span>Pago la plaza de otra persona</span>
            </label>
            <div class="otra" id="otra" hidden>
              <label class="field"><span>Nombre y apellidos del piloto</span>
                <input name="piloto_nombre" type="text" autocomplete="off" maxlength="80" />
              </label>
              <label class="field"><span>WhatsApp del piloto</span>
                <input name="piloto_telefono" type="tel" inputmode="tel" autocomplete="off" placeholder="+34 600 00 00 00" maxlength="30" />
              </label>
            </div>
            {formV2 && (
              <Fragment>
                <label class="check">
                  <input name="menor" type="checkbox" />
                  <span>El piloto es menor de edad</span>
                </label>
                <div class="otra" id="tutor" hidden>
                  <p class="aviso">{AVISO_MENOR}</p>
                  <label class="check" id="tutor-yo-caja">
                    <input name="tutor_yo" type="checkbox" />
                    <span>Soy su padre, madre o tutor legal (quien paga)</span>
                  </label>
                  <div class="otra__sub" id="tutor-datos">
                    <label class="field"><span>Nombre y apellidos del padre, madre o tutor legal</span>
                      <input name="tutor_nombre" type="text" autocomplete="off" maxlength="80" />
                    </label>
                    <label class="field"><span>WhatsApp del padre, madre o tutor legal</span>
                      <input name="tutor_telefono" type="tel" inputmode="tel" autocomplete="off" placeholder="+34 600 00 00 00" maxlength="30" />
                    </label>
                  </div>
                  <label class="field"><span>Relación con el piloto</span>
                    <select name="tutor_relacion">
                      <option value="" disabled selected>Elige una opción</option>
                      <option value="padre">Padre</option>
                      <option value="madre">Madre</option>
                      <option value="tutor_legal">Tutor legal</option>
                    </select>
                  </label>
                </div>
              </Fragment>
            )}
          </fieldset>

          <fieldset class="paso" data-paso="3">
            {conBizum && (
              <fieldset class="pay">
                <legend>Forma de pago</legend>
                <label class="pay__opt">
                  <input type="radio" name="metodo" value="tarjeta" checked />
                  <span><strong>Tarjeta</strong><small>Pago seguro con Stripe</small></span>
                </label>
                <label class="pay__opt">
                  <input type="radio" name="metodo" value="bizum" />
                  <span><strong>Bizum</strong><small>Al <span>{BIZUM.numero}</span></small></span>
                </label>
              </fieldset>
            )}

            <label class="check">
              <input name="acepta" type="checkbox" required />
              <span>He leído y acepto las <a href="/condiciones-reserva" target="_blank" rel="noopener">condiciones de la reserva</a> y la <a href="/privacidad" target="_blank" rel="noopener">política de privacidad</a>.</span>
            </label>
            {formV2 ? (
              <Fragment>
                <p class="aviso aviso--wa">{AVISO_WHATSAPP}</p>
                <label class="check">
                  <input name="novedades" type="checkbox" />
                  <span>{CASILLA_NOVEDADES} (Opcional.)</span>
                </label>
              </Fragment>
            ) : (
              <label class="check">
                <input name="comunicaciones" type="checkbox" />
                <span>Quiero recibir novedades de RUKC por WhatsApp o email (opcional).</span>
              </label>
            )}
            <label class="trampa" aria-hidden="true">Web <input name="sitio_web" type="text" tabindex="-1" autocomplete="off" /></label>
          </fieldset>

          <button class="btn btn--gold card__btn" type="submit">Pagar <span data-importe>{RESERVA.importe}</span> € y reservar</button>
          <p class="card__err" id="error" role="alert"></p>
          <a class="btn btn--ghost card__btn" id="espera" href={whatsappUrl()} target="_blank" rel="noopener" hidden>Apuntarme a la lista de espera</a>
          <p class="card__foot" id="foot">Pago seguro con Stripe. RUKC no ve ni guarda los datos de tu tarjeta.</p>
        </form>

        {conBizum && (
          <section class="card bizum" id="bizum" hidden aria-labelledby="bizum-title" tabindex="-1">
            <h2 class="bizum__title" id="bizum-title">Envía el Bizum</h2>
            <ol class="bizum__steps">
              <li>
                <span>Abre la app de tu banco y envía un Bizum a este número:</span>
                <span class="bizum__num">
                  <strong class="tnum">{BIZUM.numero}</strong>
                  <button type="button" class="bizum__copy" data-copy={BIZUM.numero.replace(/\s/g, '')}>Copiar</button>
                </span>
                <small>Te aparecerá a nombre de <strong>{BIZUM.titular}</strong>.</small>
              </li>
              <li><span>Importe: <strong class="tnum"><span data-importe>{RESERVA.importe}</span> €</strong></span></li>
              <li><span>Concepto: <strong id="bizum-concepto">tu código de reserva</strong></span></li>
              <li><span>Haz una captura del Bizum enviado y mándanosla por WhatsApp con el botón de abajo.</span></li>
            </ol>
            <a class="btn btn--gold card__btn" id="bizum-wa" href={whatsappUrl()} target="_blank" rel="noopener">Enviar justificante por WhatsApp</a>
            <p class="card__foot">Tu plaza queda confirmada cuando comprobemos el Bizum. Te avisamos por WhatsApp.</p>
            <button type="button" class="bizum__back" id="bizum-back">Cambiar mis datos o pagar con tarjeta</button>
            <p class="aviso">Si cambias los datos, la reserva tendrá un código nuevo. Si ya has enviado el Bizum, escríbenos por WhatsApp antes de cambiar nada.</p>
          </section>
        )}
      </div>
    </div>
  </main>
  <Footer />
</Base>

<script>
  type Categoria = { codigo: string; nombre: string; estado: string; plazas: number; libres: number };
  type Ronda = { id: string; numero: number; fecha: string; fecha_corta: string; circuito: string; aplazada: boolean; categorias: Categoria[] };
  type Catalogo = { reserva_cent: number; carrera_cent: number | null; rondas: Ronda[]; aviso_borradores: { texto: string; provisional: boolean } };

  const form = document.getElementById('reserva') as HTMLFormElement;
  const el = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const campo = <T extends HTMLInputElement | HTMLSelectElement = HTMLInputElement>(n: string) => form.elements.namedItem(n) as T;
  const err = el('error');
  const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
  const foot = el('foot');
  const bizum = document.getElementById('bizum');
  const selRonda = campo<HTMLSelectElement>('ronda');
  const selCat = campo<HTMLSelectElement>('categoria');
  const otra = campo('otra');
  // Formulario v2: versión de los textos de WhatsApp (vacía con el formulario anterior).
  const textosV2 = form.dataset.v2 || '';
  const v2 = Boolean(textosV2);
  const menor = () => v2 && campo('menor').checked;
  const tutorYo = () => menor() && otra.checked && campo('tutor_yo').checked;

  const S_TOKEN = 'rukc_solicitud';
  const S_CAMPOS = 'rukc_reserva';
  const ss = {
    leer: (k: string) => { try { return JSON.parse(sessionStorage.getItem(k) || 'null'); } catch { return null; } },
    poner: (k: string, v: unknown) => { try { sessionStorage.setItem(k, JSON.stringify(v)); } catch {} },
    quitar: (k: string) => { try { sessionStorage.removeItem(k); } catch {} },
  };
  const ls = (k: string) => { try { return localStorage.getItem(k); } catch { return null; } };
  const cookie = (n: string) => document.cookie.match(new RegExp(`(?:^|; )${n}=([^;]+)`))?.[1] ?? null;
  const origen = (k: string) => { try { return JSON.parse(ls(k) || 'null'); } catch { return null; } };

  let catalogo: Catalogo | null = null;
  let borrador: { token: string; codigo: string } | null = ss.leer(S_TOKEN);
  let cola: Promise<unknown> = Promise.resolve();
  let temporizador: number | undefined;
  let pasoMax = 1;
  let reservaEur = Number(el('importe').textContent);

  // Medición en Meta solo para quien llegó desde la landing de anuncios y no rechazó sus cookies.
  const fbp = cookie('_fbp'), fbc = cookie('_fbc');
  const medicion = ls('rukc_consent') !== 'no' && Boolean(fbp || ls('rukc_consent') === 'yes');

  const metodo = () => (form.elements.namedItem('metodo') as RadioNodeList | null)?.value === 'bizum' ? 'bizum' : 'tarjeta';
  const TEXTO = {
    tarjeta: { btn: () => `Pagar ${reservaEur} € y reservar`, foot: 'Pago seguro con Stripe. RUKC no ve ni guarda los datos de tu tarjeta.' },
    bizum: { btn: () => 'Continuar con Bizum', foot: 'Te mostramos el número y el código para enviar el Bizum.' },
  };
  const pintarMetodo = () => { btn.textContent = TEXTO[metodo()].btn(); foot.textContent = TEXTO[metodo()].foot; };

  const telValido = (v: string) => v.replace(/\D/g, '').length >= 9;
  const emailValido = (v: string) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);

  /** Campos tal como los espera /api/solicitud. Lo que aún no es válido va vacío. */
  function campos() {
    const v = (n: string) => campo(n).value.trim();
    const email = v('email'), tel = v('telefono'), ptel = v('piloto_telefono');
    return {
      ronda_id: selRonda.value || null,
      categoria_elegida: selCat.value || null,
      pagador_nombre: v('nombre'),
      pagador_email: emailValido(email) ? email : '',
      pagador_telefono: telValido(tel) ? tel : '',
      piloto_es_pagador: !otra.checked,
      piloto_nombre: otra.checked ? v('piloto_nombre') : '',
      piloto_telefono: otra.checked && telValido(ptel) ? ptel : '',
      metodo_elegido: metodo(),
      paso_actual: pasoMax,
      ...(v2 ? camposV2(v, tel) : { acepta_comunicaciones: campo('comunicaciones').checked }),
    };
  }

  /** Formulario v2: menor, tutor y casilla de novedades. Si el tutor es quien paga, sus datos son los del pagador. */
  function camposV2(v: (n: string) => string, tel: string) {
    const ttel = tutorYo() ? tel : v('tutor_telefono');
    return {
      piloto_menor: menor(),
      tutor_nombre: menor() ? (tutorYo() ? v('nombre') : v('tutor_nombre')) : '',
      tutor_telefono: menor() && telValido(ttel) ? ttel : '',
      tutor_relacion: menor() ? (campo<HTMLSelectElement>('tutor_relacion').value || null) : null,
      acepta_whatsapp_novedades: campo('novedades').checked,
      acepta_comunicaciones: false,
    };
  }
  /** Muestra u oculta los bloques del tutor. */
  function pintarTutor() {
    if (!v2) return;
    el('tutor').hidden = !menor();
    el('tutor-yo-caja').hidden = !otra.checked;
    el('tutor-datos').hidden = tutorYo();
  }

  const pedir = (metodoHttp: string, url: string, cuerpo?: unknown, token?: string) => fetch(url, {
    method: metodoHttp,
    headers: { 'Content-Type': 'application/json', ...(token ? { Authorization: `Bearer ${token}` } : {}) },
    body: cuerpo ? JSON.stringify(cuerpo) : undefined,
  });

  /** Guarda el borrador: lo crea en cuanto hay un teléfono o un email válido; después lo actualiza. */
  async function guardar() {
    const c = campos();
    if (!c.pagador_telefono && !c.pagador_email) return;
    const trampa = campo('sitio_web').value;
    if (borrador) {
      const res = await pedir('PATCH', '/api/solicitud', { campos: c, consentimiento_medicion: medicion, sitio_web: trampa }, borrador.token).catch(() => null);
      if (res?.ok) return;
      if (res?.status === 409 && (await res.json().catch(() => ({}))).estado === 'pagada') { location.href = '/inscripcion/confirmada'; return; }
      if (res && (res.status === 404 || res.status === 409 || res.status === 401)) { borrador = null; ss.quitar(S_TOKEN); }
      else return;
    }
    const res = await pedir('POST', '/api/solicitud', {
      campos: c, consentimiento_medicion: medicion, fbc, fbp, sitio_web: trampa,
      origen: { ultimo: origen('rukc_origen'), primero: origen('rukc_origen_primero') },
    }).catch(() => null);
    if (res?.status === 201) { borrador = await res.json(); ss.poner(S_TOKEN, borrador); }
  }
  const encolar = () => (cola = cola.then(guardar, guardar));
  const programar = () => { window.clearTimeout(temporizador); temporizador = window.setTimeout(encolar, 2000); };

  function recordar() {
    const v: Record<string, string | boolean> = {};
    for (const n of ['nombre', 'email', 'telefono', 'piloto_nombre', 'piloto_telefono', 'categoria']) v[n] = campo(n).value;
    v.otra = otra.checked;
    if (v2) {
      for (const n of ['tutor_nombre', 'tutor_telefono', 'tutor_relacion']) v[n] = campo(n).value;
      v.menor = campo('menor').checked;
      v.tutor_yo = campo('tutor_yo').checked;
    }
    v.ronda = selRonda.value;
    ss.poner(S_CAMPOS, v);
  }

  // ---------- catálogo: rondas, cupos, importes y aviso de borradores ----------
  const ronda = () => catalogo?.rondas.find((r) => r.id === selRonda.value) ?? null;
  function pintarRonda() {
    const r = ronda();
    el('sum-ronda').textContent = r ? ` · R${r.numero} ${r.circuito}` : '';
    const aviso = el('cupo');
    const cat = selCat.value;
    let texto = '';
    if (r && cat) {
      const cats = cat === 'no_se' ? r.categorias : r.categorias.filter((c) => c.codigo === cat);
      if (cats.length && cats.every((c) => c.estado === 'cerrada')) texto = 'La inscripción de esta ronda está cerrada en tu categoría. Puedes apuntarte a la lista de espera.';
      else if (cats.some((c) => c.estado === 'lista_espera') && !cats.some((c) => c.estado === 'abierta')) texto = 'Categoría completa: puedes apuntarte a la lista de espera.';
      else if (cat !== 'no_se' && cats[0]?.estado === 'abierta' && cats[0].libres > 0 && cats[0].libres <= 10) texto = `Quedan ${cats[0].libres} plazas en esta categoría.`;
    }
    aviso.textContent = texto;
    aviso.hidden = !texto;
  }

  async function cargarCatalogo() {
    try {
      const res = await fetch('/api/catalogo');
      if (!res.ok) throw new Error();
      catalogo = await res.json();
    } catch {
      selRonda.innerHTML = '<option value="" disabled selected>No se ha podido cargar el calendario</option>';
      err.textContent = 'No se ha podido cargar el calendario. Recarga la página o escríbenos por WhatsApp.';
      btn.disabled = true;
      return;
    }
    const c = catalogo!;
    el('aviso-texto').textContent = c.aviso_borradores.texto.replace(/[*_#>`]/g, '').trim();
    el('aviso-tag').hidden = !c.aviso_borradores.provisional;
    reservaEur = c.reserva_cent / 100;
    document.querySelectorAll('[data-importe]').forEach((n) => { n.textContent = String(reservaEur); });
    el('importe').textContent = String(reservaEur);
    if (c.carrera_cent) {
      el('descuento').textContent = `Se descuentan del precio de la carrera (${c.carrera_cent / 100} €): después solo pagas ${(c.carrera_cent - c.reserva_cent) / 100} €.`;
    }
    selRonda.innerHTML = '';
    for (const r of c.rondas) {
      const o = document.createElement('option');
      o.value = r.id;
      o.dataset.numero = String(r.numero);
      o.textContent = `R${r.numero} · ${r.fecha_corta} · ${r.circuito}${r.aplazada ? ' (aplazada)' : ''}`;
      selRonda.append(o);
    }
    el('sin-rondas').hidden = c.rondas.length > 0;
    btn.disabled = c.rondas.length === 0;
    // ?ronda=<número> (enlaces del bot) o ?r=<número o id> (botón de la plantilla rukc_seguimiento_reserva).
    const qs = new URLSearchParams(location.search);
    const pedida = qs.get('ronda') ?? qs.get('r');
    const guardados = ss.leer(S_CAMPOS);
    const porNumero = [...selRonda.options].find((o) => o.dataset.numero === pedida || (pedida && o.value === pedida));
    if (porNumero) selRonda.value = porNumero.value;
    else if (guardados?.ronda && [...selRonda.options].some((o) => o.value === guardados.ronda)) selRonda.value = guardados.ronda;
    pintarRonda();
    pintarMetodo();
  }

  // ---------- inicio ----------
  const guardados = ss.leer(S_CAMPOS);
  if (guardados) {
    for (const n of ['nombre', 'email', 'telefono', 'piloto_nombre', 'piloto_telefono', 'categoria']) if (guardados[n]) campo(n).value = guardados[n];
    otra.checked = Boolean(guardados.otra);
    if (v2) {
      for (const n of ['tutor_nombre', 'tutor_telefono', 'tutor_relacion']) if (guardados[n]) campo(n).value = guardados[n];
      campo('menor').checked = Boolean(guardados.menor);
      campo('tutor_yo').checked = Boolean(guardados.tutor_yo);
    }
  }
  el('otra').hidden = !otra.checked;
  pintarTutor();
  if (new URLSearchParams(location.search).has('cancelado')) el('cancelado').hidden = false;
  pintarMetodo();
  cargarCatalogo();

  form.addEventListener('input', () => { err.textContent = ''; el('espera').hidden = true; recordar(); programar(); });
  form.addEventListener('change', (e) => {
    const n = (e.target as HTMLInputElement).name;
    if (n === 'metodo') pintarMetodo();
    if (n === 'ronda' || n === 'categoria') pintarRonda();
    if (n === 'otra') el('otra').hidden = !otra.checked;
    if (n === 'otra' || n === 'menor' || n === 'tutor_yo') pintarTutor();
    recordar();
    programar();
  });
  // Cambio de bloque (ronda → datos → pago): se guarda en el momento.
  form.addEventListener('focusin', (e) => {
    const paso = Number((e.target as HTMLElement).closest<HTMLElement>('[data-paso]')?.dataset.paso || 0);
    if (paso > pasoMax) { pasoMax = paso; window.clearTimeout(temporizador); encolar(); }
  });

  function validar() {
    const v = (n: string) => campo(n).value.trim();
    if (!selRonda.value) return 'Elige la ronda que quieres reservar.';
    if (!selCat.value) return 'Elige tu categoría.';
    if (v('nombre').length < 2) return 'Escribe tu nombre y apellidos.';
    if (!emailValido(v('email'))) return 'Revisa tu correo.';
    if (!telValido(v('telefono'))) return 'Revisa tu número de WhatsApp.';
    if (otra.checked && (v('piloto_nombre').length < 2 || !telValido(v('piloto_telefono')))) return 'Escribe el nombre y el WhatsApp del piloto.';
    if (menor() && !tutorYo() && (v('tutor_nombre').length < 2 || !telValido(v('tutor_telefono')))) return 'Escribe el nombre y el WhatsApp del padre, madre o tutor legal.';
    if (menor() && !campo<HTMLSelectElement>('tutor_relacion').value) return 'Elige la relación del tutor con el piloto.';
    if (!campo('acepta').checked) return 'Tienes que aceptar las condiciones de la reserva.';
    return '';
  }

  function mostrarBizum(b: { codigo: string; whatsapp: string; importe_cent: number }) {
    el('bizum-concepto').textContent = b.codigo;
    (el('bizum-wa') as HTMLAnchorElement).href = b.whatsapp;
    document.querySelectorAll('[data-importe]').forEach((n) => { n.textContent = String(b.importe_cent / 100); });
    form.hidden = true;
    bizum!.hidden = false;
    bizum!.focus({ preventScroll: true });
    bizum!.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
  }

  bizum?.querySelector<HTMLButtonElement>('[data-copy]')?.addEventListener('click', async (e) => {
    const b = e.currentTarget as HTMLButtonElement;
    try { await navigator.clipboard.writeText(b.dataset.copy!); b.textContent = 'Copiado'; } catch { b.textContent = b.dataset.copy!; }
    setTimeout(() => { b.textContent = 'Copiar'; }, 2000);
  });
  document.getElementById('bizum-back')?.addEventListener('click', () => {
    bizum!.hidden = true;
    form.hidden = false;
    form.scrollIntoView({ block: 'start' });
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fallo = validar();
    err.textContent = fallo;
    if (fallo) return;
    btn.disabled = true;
    btn.textContent = metodo() === 'bizum' ? 'Preparando el Bizum…' : 'Abriendo el pago…';
    try {
      window.clearTimeout(temporizador);
      await encolar();
      if (!borrador) throw new Error('No se ha podido guardar tu solicitud. Revisa tu conexión e inténtalo de nuevo.');
      const res = await pedir('POST', '/api/checkout', { metodo: metodo(), acepta: true, sitio_web: campo('sitio_web').value, ...(v2 ? { textos: textosV2 } : {}) }, borrador.token);
      const r = await res.json().catch(() => ({}));
      if (res.ok && r.url) { location.href = r.url; return; }
      if (res.ok && r.bizum) { mostrarBizum(r.bizum); return; }
      if (r.estado === 'pagada') { location.href = '/inscripcion/confirmada'; return; }
      err.textContent = r.error || 'No se ha podido abrir el pago. Inténtalo de nuevo en un momento.';
      if (r.lista_espera) { (el('espera') as HTMLAnchorElement).href = r.lista_espera; el('espera').hidden = false; }
    } catch (x) {
      err.textContent = (x as Error).message || 'Sin conexión. Revisa tu internet e inténtalo de nuevo.';
    }
    btn.disabled = false;
    pintarMetodo();
  });
</script>

