---
// Ajustes: entidad cobradora (solo el propietario puede cambiarla), tareas programadas y copias de seguridad, e
// historial de eventos.
import Admin from '../../layouts/Admin.astro';
---
<Admin titulo="Ajustes" seccion="ajustes">
  <section class="caja">
    <h2>Entidad cobradora</h2>
    <p class="sub">Quién cobra los pagos nuevos. Hoy, la titular de la cuenta de Stripe; cuando exista la sociedad, se cambia aquí.</p>
    <form class="form" id="entidad">
      <div class="dos">
        <label class="campo">Nombre comercial <input name="nombre_comercial" required /></label>
        <label class="campo">Titular legal <input name="titular_legal" /></label>
        <label class="campo">NIF <input name="nif" /></label>
        <label class="campo">Tipo <select name="tipo"><option value="">Sin indicar</option><option value="persona_fisica">Persona física</option><option value="empresa">Empresa</option><option value="sociedad">Sociedad</option></select></label>
        <label class="campo">Activa desde <input name="activa_desde" type="date" /></label>
      </div>
      <button class="b" type="submit">Guardar</button>
    </form>
  </section>
  <section class="caja"><h2>Tareas y copias de seguridad</h2>
    <p class="sub">La tarea diaria (03:00 UTC) marca los Bizum sin confirmar en 72 h y el feedback caducado, hace la copia cifrada, mira el consumo de Neon y, el día 1, cuenta las personas con el plazo de conservación vencido. Si un paso falla no se reintenta: sale aquí y en "Hoy".</p>
    <div id="sistema"><p class="vacio">Cargando…</p></div>
  </section>
  <section class="caja"><h2>Historial</h2><div id="historial"></div></section>
  <section class="caja">
    <h2>Sesiones</h2>
    <p class="sub">El panel te recuerda 30 días en cada dispositivo donde entres. Si pierdes el móvil o el portátil, cierra todas las sesiones: tendrás que volver a entrar con contraseña y código en todos.</p>
    <button class="b b--peligro" type="button" id="salir-todos">Cerrar sesión en todos los dispositivos</button>
  </section>
</Admin>

<script>
  import { api, accion, fechaHora, h, salirDeTodos } from '../../scripts/admin/api';
  document.getElementById('salir-todos')!.addEventListener('click', async () => {
    if (confirm('Se cerrará la sesión en todos tus dispositivos, también en este. ¿Seguir?')) await accion(() => salirDeTodos());
  });
  import { crearLista } from '../../scripts/admin/lista';
  const form = document.getElementById('entidad') as HTMLFormElement;
  const campos = ['nombre_comercial', 'titular_legal', 'nif', 'tipo', 'activa_desde'];
  api('entidad').then((d) => { for (const c of campos) (form.elements.namedItem(c) as HTMLInputElement).value = d.entidad?.[c] ?? ''; });
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const v = (c: string) => (form.elements.namedItem(c) as HTMLInputElement).value.trim() || null;
    await accion(() => api('entidad', { nombre_comercial: v('nombre_comercial'), titular_legal: v('titular_legal'), nif: v('nif'), tipo: v('tipo'), activa_desde: v('activa_desde') }), 'Guardado.');
  });
  crearLista({ vista: 'eventos', contenedor: document.getElementById('historial')! });

  const NOMBRES: Record<string, string> = { bizum: 'Bizum sin confirmar', feedback: 'Feedback caducado', copia: 'Copia de seguridad', neon: 'Consumo de Neon', anonimizacion: 'Plazo de conservación' };
  api('sistema').then((d) => {
    const fila = (t: string, s: string) => h('div', { class: 'fila' }, h('div', { class: 'txt' }, h('span', {}, t), h('span', { class: 'sub' }, s)));
    const mb = (b: number) => `${(b / 1048576).toFixed(2)} MB`;
    document.getElementById('sistema')!.replaceChildren(...[
      ...(d.ultimas.length ? d.ultimas.map((u: any) => fila(`${NOMBRES[u.tarea] ?? u.tarea}: ${u.ok ? 'bien' : 'ERROR'}`, `${fechaHora(u.cuando)}${u.error ? ` · ${u.error}` : ''}`))
        : [h('p', { class: 'vacio' }, 'Todavía no se ha ejecutado ninguna tarea.')]),
      d.neon ? fila(`Neon: ${d.neon.cu_horas} de ${d.neon.limite_cu_horas} CU-horas este mes (${d.neon.porcentaje} %)`, d.neon.aviso ? 'Pasa del 70 %: revisa el consumo o el plan.' : `Medido ${fechaHora(d.neon.cuando)}`) : null,
      h('h3', {}, `Copias (${d.copias.length})`),
      ...d.copias.map((c: any) => h('div', { class: 'fila' }, h('div', { class: 'txt' }, h('span', {}, c.ruta.replace('copias/', '')), h('span', { class: 'sub' }, `${mb(c.tamano)} · ${fechaHora(c.subido_en)}`)),
        h('div', { class: 'acciones' }, h('a', { class: 'b b--peq', href: `/api/admin/copias/descargar?copia=${encodeURIComponent(c.ruta)}` }, 'Descargar (cifrada)')))),
    ].filter((x): x is HTMLElement => x != null));
  }).catch(() => {});
</script>
