---
import Admin from '../../layouts/Admin.astro';
---
<Admin titulo="Inscripciones" seccion="inscripciones">
  <section class="caja"><div id="lista"></div></section>
</Admin>

<script>
  import { api, accion, h, whatsapp } from '../../scripts/admin/api';
  import { crearLista } from '../../scripts/admin/lista';
  crearLista({
    vista: 'inscripciones',
    contenedor: document.getElementById('lista')!,
    sensibles: true,
    alPulsar: (f) => { location.href = `/admin/persona?id=${f.piloto_persona_id}`; },
    acciones: (f, recargar) => h('span', { class: 'acciones' },
      h('select', { class: 'ctrl', 'aria-label': 'Categoría', onchange: async (e: Event) => {
        const v = (e.target as HTMLSelectElement).value;
        if (await accion(() => api(`inscripciones/${f.id}/categoria`, { categoria: v || null }), 'Categoría cambiada.')) recargar();
      } }, ...[['', 'Sin categoría'], ['LIG', 'Ligeros'], ['PES', 'Pesados']].map(([v, t]) => h('option', { value: v, selected: (f.categoria ?? '') === v }, t))),
      h('button', { class: 'b b--peq', type: 'button', onclick: () => whatsapp({ tipo: 'confirmacion', inscripcion_id: f.id }) }, 'Confirmación'),
      f.saldo_cent > 0 ? h('button', { class: 'b b--peq', type: 'button', onclick: () => whatsapp({ tipo: 'saldo_pendiente', inscripcion_id: f.id }) }, 'Recordar saldo') : null),
  });
</script>
