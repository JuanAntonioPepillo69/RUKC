---
// Rondas: calendario con la parrilla por categoría, interruptores de inscripción, aplazar o volver a programar,
// lista para el circuito, cobro en el circuito en un toque y acreditación (asistió o no presentado; asistió exige
// onboarding completado o un motivo de excepción).
import Admin from '../../layouts/Admin.astro';
---
<Admin titulo="Rondas" seccion="rondas">
  <div id="rondas" class="rejilla"><p class="vacio">Cargando…</p></div>
  <dialog class="dlg" id="cobros">
    <h2 style="margin-top:0">Cobro en circuito</h2>
    <div id="cobros-lista"></div>
    <form method="dialog"><button class="b" style="margin-top:12px">Cerrar</button></form>
  </dialog>
  <dialog class="dlg" id="canceladas">
    <h2 style="margin-top:0">Resolver cancelaciones</h2>
    <div id="canceladas-lista"></div>
    <form method="dialog"><button class="b" style="margin-top:12px">Cerrar</button></form>
  </dialog>
  <dialog class="dlg" id="acreditacion">
    <h2 style="margin-top:0">Acreditación</h2>
    <div id="acreditacion-lista"></div>
    <form method="dialog"><button class="b" style="margin-top:12px">Cerrar</button></form>
  </dialog>
</Admin>

<script>
  import { api, accion, aviso, etiquetaEstado, euros, fecha, formulario, h } from '../../scripts/admin/api';
  import * as Op from '../../scripts/admin/operacion';
  const raiz = document.getElementById('rondas')!;
  const dlg = document.getElementById('cobros') as HTMLDialogElement;

  async function abrirCobros(r: any) {
    const lista = document.getElementById('cobros-lista')!;
    const pintar = async () => {
      const d = await api(`rondas/${r.id}/cobros`);
      lista.replaceChildren(h('p', { class: 'sub' }, `R${r.numero} · ${r.circuito}: inscritos con saldo pendiente.`),
        ...(d.inscripciones.length ? d.inscripciones.map((i: any) => h('div', { class: 'fila' },
          h('div', { class: 'txt' }, h('span', {}, `${i.dorsal ? `#${i.dorsal} ` : ''}${i.piloto}`), h('span', { class: 'sub' }, `${i.categoria ?? '-'} · pagado ${euros(i.pagado_cent)} · falta ${euros(i.saldo_cent)}`)),
          h('div', { class: 'acciones' },
            h('button', { class: 'b b--oro', type: 'button', onclick: async () => {
              if (await accion(() => api(`rondas/${r.id}/cobro`, { inscripcion_id: i.id }), `Cobrados ${euros(i.saldo_cent)} en efectivo.`)) pintar();
            } }, `Cobrado ${euros(i.saldo_cent)} en efectivo`),
            h('button', { class: 'b b--peq', type: 'button', onclick: async () => {
              const t = prompt('Importe cobrado en euros:', String(i.saldo_cent / 100));
              if (!t) return;
              const importe = Math.round(Number(t.replace(',', '.')) * 100);
              if (await accion(() => api(`rondas/${r.id}/cobro`, { inscripcion_id: i.id, importe_cent: importe }), 'Cobro anotado.')) pintar();
            } }, 'Otro importe'))))
          : [h('p', { class: 'vacio' }, 'Nadie tiene saldo pendiente en esta ronda.')]));
    };
    await pintar();
    dlg.showModal();
  }

  // F8: inscripciones de una ronda cancelada, cada una con su resolución (reembolso, crédito, traslado o sin devolución).
  const dlgCan = document.getElementById('canceladas') as HTMLDialogElement;
  async function abrirCanceladas(r: any) {
    const lista = document.getElementById('canceladas-lista')!;
    const pintar = async () => {
      const d = await api(`rondas/${r.id}/canceladas`);
      const pendientes = d.inscripciones.filter((i: any) => i.resolucion === 'pendiente').length;
      lista.replaceChildren(h('p', { class: 'sub' }, `R${r.numero} · ${r.circuito}: ${pendientes} por resolver de ${d.inscripciones.length}.`),
        ...(d.inscripciones.length ? d.inscripciones.map((i: any) => h('div', { class: 'fila' },
          h('div', { class: 'txt' }, h('span', {}, `${i.piloto} · ${i.codigo}`),
            h('span', { class: 'sub' }, `pagado ${euros(i.pagado_cent)}${i.credito_cent ? ` + crédito ${euros(i.credito_cent)}` : ''}${i.pagos.length ? ` · ${i.pagos.map((p: any) => `${p.codigo} ${p.stripe ? 'Stripe' : p.metodo.replace('_', ' ')}`).join(', ')}` : ''}`)),
          h('div', { class: 'acciones' }, i.resolucion === 'pendiente'
            ? h('button', { class: 'b b--peq b--oro', type: 'button', onclick: async () => { if (await Op.resolver(i)) pintar(); } }, 'Resolver')
            : etiquetaEstado(i.resolucion))))
          : [h('p', { class: 'vacio' }, 'No había inscripciones activas.')]));
    };
    await pintar();
    dlgCan.showModal();
  }

  const dlgAcr = document.getElementById('acreditacion') as HTMLDialogElement;
  async function abrirAcreditacion(r: any) {
    const lista = document.getElementById('acreditacion-lista')!;
    const marcar = async (i: any, estado: string) => {
      let motivo: string | undefined;
      if (estado === 'asistio' && i.onboarding !== 'completado') {
        motivo = prompt(`${i.piloto} no ha completado el onboarding. Motivo de la excepción (obligatorio):`) ?? '';
        if (!motivo.trim()) return;
      }
      if (await accion(() => api(`inscripciones/${i.id}/asistencia`, { estado, motivo }), estado === 'asistio' ? 'Marcado: asistió.' : 'Marcado: no presentado.')) pintar();
    };
    const pintar = async () => {
      const d = await api(`rondas/${r.id}/acreditacion`);
      lista.replaceChildren(h('p', { class: 'sub' }, `R${r.numero} · ${r.circuito}`),
        ...(d.inscripciones.length ? d.inscripciones.map((i: any) => h('div', { class: 'fila' },
          h('div', { class: 'txt' }, h('span', {}, `${i.dorsal ? `#${i.dorsal} ` : ''}${i.piloto}`),
            h('span', { class: 'sub' }, `${i.categoria ?? '-'} · onboarding ${(i.onboarding ?? 'sin empezar').replace('_', ' ')}${i.saldo_cent > 0 ? ` · debe ${euros(i.saldo_cent)}` : ''}${i.motivo ? ` · ${i.motivo}` : ''}`)),
          h('div', { class: 'acciones' },
            ['asistio', 'no_presentado'].includes(i.estado) ? etiquetaEstado(i.estado) : null,
            i.estado === 'pendiente_pago' ? h('span', { class: 'sub' }, 'Sin pago confirmado') : null,
            ['reservada', 'pagada'].includes(i.estado) ? h('button', { class: 'b b--peq b--oro', type: 'button', onclick: () => marcar(i, 'asistio') }, 'Asistió') : null,
            ['reservada', 'pagada'].includes(i.estado) ? h('button', { class: 'b b--peq', type: 'button', onclick: () => marcar(i, 'no_presentado') }, 'No presentado') : null)))
          : [h('p', { class: 'vacio' }, 'No hay inscritos en esta ronda.')]));
    };
    await pintar();
    dlgAcr.showModal();
  }

  async function cargar() {
    const d = await api('rondas');
    raiz.replaceChildren(...d.rondas.map((r: any) => h('section', { class: 'caja' },
      h('h2', {}, `R${r.numero} · ${r.circuito}`, etiquetaEstado(r.estado)),
      h('p', { class: 'sub' }, `${fecha(r.fecha)}${r.notas ? ` · ${r.notas}` : ''}`),
      ...r.cupos.map((c: any) => h('div', { class: 'fila' },
        h('div', { class: 'txt' }, h('span', {}, `${c.categoria}: ${c.inscritos}/${c.plazas}${c.en_sobrecupo ? ' · SOBRECUPO' : ''}`), h('span', { class: 'sub' }, `${c.pagados} pagados · ${c.reservados} con reserva · ${c.libres} libres`)),
        h('div', { class: 'acciones' }, ...['abierta', 'lista_espera', 'cerrada'].map((e) => h('button', {
          class: `b b--peq${c.estado_cupo === e ? ' b--oro' : ''}`, type: 'button', disabled: !['programada', 'aplazada'].includes(r.estado),
          onclick: async () => { if (await accion(() => api(`rondas/${r.id}/cupo`, { categoria: c.categoria, estado: e }), `Inscripción ${e.replace('_', ' ')} en ${c.categoria}.`)) cargar(); },
        }, e === 'lista_espera' ? 'Lista de espera' : e === 'abierta' ? 'Abrir' : 'Cerrar'))))),
      h('div', { class: 'acciones' },
        h('button', { class: 'b b--peq', type: 'button', onclick: () => abrirCobros(r) }, 'Cobro en circuito'),
        h('button', { class: 'b b--peq', type: 'button', onclick: () => abrirAcreditacion(r) }, 'Acreditación'),
        r.estado === 'cancelada' ? h('button', { class: 'b b--peq b--oro', type: 'button', onclick: () => abrirCanceladas(r) }, 'Resolver cancelaciones') : null,
        ['programada', 'aplazada'].includes(r.estado) ? h('button', { class: 'b b--peq b--peligro', type: 'button', onclick: async () => {
          const v = await formulario(`Cancelar la R${r.numero}`, [{ nombre: 'motivo', etiqueta: 'Motivo', tipo: 'textarea', requerido: true }], 'Cancelar la ronda',
            'Todas sus inscripciones activas pasan a canceladas con la resolución pendiente. No se puede deshacer.');
          if (!v) return;
          const res = await accion(() => api<any>(`rondas/${r.id}/cancelar`, { motivo: v.motivo }), '');
          if (res) { aviso(`Ronda cancelada: ${res.canceladas} inscripciones por resolver.`); await cargar(); abrirCanceladas({ ...r, estado: 'cancelada' }); }
        } }, 'Cancelar ronda') : null,
        h('a', { class: 'b b--peq', href: `/api/admin/exportar/circuito?formato=xlsx&f=${encodeURIComponent(JSON.stringify([{ c: 'ronda', op: 'eq', v: r.numero }]))}` }, 'Lista para el circuito'),
        r.estado === 'programada' ? h('button', { class: 'b b--peq', type: 'button', onclick: async () => {
          const f = prompt('Nueva fecha (AAAA-MM-DD):', r.fecha);
          if (!f) return;
          const res = await accion(() => api(`rondas/${r.id}/aplazar`, { fecha: f }), 'Ronda aplazada.');
          if (res) { aviso((res as any).aviso); cargar(); }
        } }, 'Aplazar') : null,
        r.estado === 'aplazada' ? h('button', { class: 'b b--peq', type: 'button', onclick: async () => {
          const f = prompt('Fecha definitiva (AAAA-MM-DD):', r.fecha);
          if (!f) return;
          const res = await accion(() => api(`rondas/${r.id}/reprogramar`, { fecha: f }), 'Ronda programada.');
          if (res) { aviso((res as any).aviso); cargar(); }
        } }, 'Volver a programar') : null))));
  }
  cargar().catch(() => {});
</script>
