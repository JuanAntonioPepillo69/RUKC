---
// Recuperar: solicitudes del formulario en borrador, enviadas sin pagar o con el pago abandonado.
import Admin from '../../layouts/Admin.astro';
---
<Admin titulo="Recuperar" seccion="recuperar">
  <section class="caja"><div id="lista"></div></section>
</Admin>

<script>
  import { api, accion, h, whatsapp } from '../../scripts/admin/api';
  import { crearLista } from '../../scripts/admin/lista';
  crearLista({
    vista: 'recuperar',
    contenedor: document.getElementById('lista')!,
    alPulsar: (f) => { if (f.persona_id) location.href = `/admin/persona?id=${f.persona_id}`; },
    acciones: (f, recargar) => h('span', { class: 'acciones' },
      f.pagador_telefono ? h('button', { class: 'b b--peq', type: 'button', onclick: () => whatsapp({ tipo: f.estado === 'borrador' ? 'recuperar_borrador' : 'recuperar_pago', solicitud_id: f.id }) }, 'WhatsApp') : null,
      f.estado !== 'enviada' ? h('button', { class: 'b b--peq b--peligro', type: 'button', onclick: async () => {
        if (confirm(`¿Descartar ${f.codigo}?`) && await accion(() => api(`solicitudes/${f.id}/descartar`, {}), 'Descartada.')) recargar();
      } }, 'Descartar') : null),
  });
</script>
