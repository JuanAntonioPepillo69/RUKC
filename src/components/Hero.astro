---
// Hero con secuencia de frames controlada por el scroll.
// Los frames los genera tools/hero (render.mjs + encode.mjs): public/hero/manifest.json describe la secuencia
// y public/hero/anchors-{d,m}.json da, frame a frame, dónde está en pantalla cada pieza señalada.
import manifest from '../../public/hero/manifest.json';
import { whatsappUrl } from '../config/site';
import { CIRCUITOS, RONDAS, fechaCorta, type CircuitoId } from '../data/calendario';

const pad = (n: number) => String(n).padStart(3, '0');
const D = manifest.variants.d;
const M = manifest.variants.m;
const C = manifest.cues;

// Titulares: cada uno con su tramo del scroll y su posición en escritorio (d) y en vertical (m)
const beats = [
  { id: 'engine', at: C.engine, d: 'l', m: 'top', n: '01', eyebrow: 'Igualdad mecánica', title: 'Mismos karts',
    desc: 'Karts de alquiler mecánicamente equivalentes y asignados por sorteo. Nadie elige montura.' },
  { id: 'belt', at: C.belt, d: 'r', m: 'top', n: '02', eyebrow: 'Igualdad de peso', title: 'Lastre',
    desc: 'Peso mínimo de 70 kg en Ligeros y de 85 kg en Pesados. Quien no llega, lo completa con un cinturón de lastre.' },
  { id: 'cats', at: C.cats, d: 'bl', m: 'bottom', n: '03', eyebrow: 'Categorías por peso', title: 'Dos campeonatos',
    desc: 'Ligeros y Pesados: cada categoría con su parrilla, sus puntos y su campeón.' },
  { id: 'pins', at: [C.pins[0], C.pins[1] + 0.006], d: 'bl', m: 'bottom', n: '04', eyebrow: 'Provincia de Málaga', title: 'Cinco circuitos',
    desc: 'De Estepona a Almayate y de la costa a Campillos.' },
  { id: 'rounds', at: C.rounds, d: 'br', m: 'bottom', n: '05', eyebrow: 'Temporada 2', title: 'Ocho rondas',
    desc: 'Ocho sábados, del 17 de octubre de 2026 al 3 de julio de 2027. La final y la gala, en Campillos.' },
];

// Etiquetas pegadas a una pieza de la escena. d / m = desplazamiento en px de la etiqueta respecto al punto.
const rondasDe = (id: CircuitoId) => RONDAS.filter((r) => r.circuito === id).map((r) => `R${r.ronda} · ${fechaCorta(r.fecha)}`);
const pinsAt = (i: number) => C.pins[0] + (i * (C.pins[1] - C.pins[0])) / 6;
const circuitOrder: CircuitoId[] = ['mijas', 'campillos', 'kfmalaga', 'delsol', 'kfestepona'];
const pinOffsets: Record<CircuitoId, { d: number[]; m: number[] }> = {
  campillos: { d: [-90, -34], m: [-30, -64] },
  kfestepona: { d: [-90, -60], m: [-20, 84] },
  mijas: { d: [-40, 110], m: [10, 124] },
  kfmalaga: { d: [60, -90], m: [18, -60] },
  delsol: { d: [90, -60], m: [-10, -150] },
};
const tags = [
  { anchor: 'engine', at: [C.engine[0] + 0.01, C.engine[1]], d: [130, -120], m: [60, 120], label: 'Motor', sub: ['Igual para todos'] },
  { anchor: 'belt', at: [C.belt[0] + 0.01, C.belt[1]], d: [150, -110], m: [-80, 130], label: 'Cinturón de lastre', sub: ['Plomo en caderas y zona lumbar'] },
  { anchor: 'kartB', at: [C.cats[0] + 0.012, C.cats[1]], d: [-70, -80], m: [40, -90], label: 'Pesados', sub: ['85 kg o más'] },
  { anchor: 'kartA', at: [C.cats[0] + 0.018, C.cats[1]], d: [70, -80], m: [-40, -90], label: 'Ligeros', sub: ['70 a 80 kg'] },
  ...circuitOrder.map((id, i) => ({
    anchor: id, at: [pinsAt(i) + 0.012, C.rounds[1]], d: pinOffsets[id].d, m: pinOffsets[id].m,
    label: CIRCUITOS[id].nombre, sub: rondasDe(id), subAt: C.rounds[0],
  })),
];
---
<section class="hero" data-hero data-manifest={JSON.stringify(manifest)} aria-label="Presentación de RUKC">
  <div class="hero__stage">
    <picture class="hero__poster">
      <source media="(prefers-reduced-motion: reduce) and (max-aspect-ratio: 9/10) and (max-width: 899px)" srcset={`/hero/m/${pad(M.frames)}.webp`} width={M.width} height={M.height} />
      <source media="(prefers-reduced-motion: reduce)" srcset={`/hero/d/${pad(D.frames)}.webp`} width={D.width} height={D.height} />
      <source media="(max-aspect-ratio: 9/10) and (max-width: 899px)" srcset="/hero/m/001.webp" width={M.width} height={M.height} />
      <img src="/hero/d/001.webp" width={D.width} height={D.height} alt="" fetchpriority="high" />
    </picture>
    <canvas class="hero__canvas" aria-hidden="true"></canvas>

    <div class="hero__tags" aria-hidden="true">
      {tags.map((t) => (
        <div class="tag" data-tag={t.anchor} data-at={t.at.join(',')} data-sub-at={(t as { subAt?: number }).subAt} data-d={t.d.join(',')} data-m={t.m.join(',')}>
          <div class="tag__inner">
            <span class="tag__dot"></span>
            <span class="tag__line"></span>
            <span class="tag__box">
              <strong>{t.label}</strong>
              {t.sub.map((s) => <span class="tag__sub">{s}</span>)}
            </span>
          </div>
        </div>
      ))}
    </div>

    <div class="beat beat--intro" data-beat="intro" data-d="bl" data-m="bottom">
      <p class="eyebrow">RaceUp Karting Championship</p>
      <h1>La liga de karting de alquiler de la Costa del Sol</h1>
      <p class="beat__desc">Elitista en la pista. Accesible para cualquiera que quiera competir de verdad.</p>
    </div>

    {beats.map((b) => (
      <div class="beat" data-beat={b.id} data-at={b.at.join(',')} data-d={b.d} data-m={b.m}>
        <p class="beat__num tnum">{b.n}<span> / 05</span></p>
        <p class="eyebrow">{b.eyebrow}</p>
        <h2 class="beat__title">{b.title}</h2>
        <p class="beat__desc">{b.desc}</p>
      </div>
    ))}

    <div class="beat beat--final" data-beat="final" data-d="bl" data-m="bottom">
      <p class="eyebrow">Temporada 2</p>
      <p class="beat__dates tnum">17 oct 2026 <span aria-hidden="true">/</span> 3 jul 2027</p>
      <div class="beat__ctas">
        <a class="btn btn--gold" href={whatsappUrl()} target="_blank" rel="noopener">Quiero correr</a>
        <a class="btn btn--ghost" href="/season-2">Calendario y clasificación</a>
      </div>
    </div>

    <p class="hero__hint" data-hint aria-hidden="true"><span></span>Desliza</p>
  </div>
</section>

<script>
  import { initHero } from '../scripts/hero';
  document.querySelectorAll<HTMLElement>('[data-hero]').forEach(initHero);
</script>

<style>
  .hero { position: relative; height: 900svh; background: var(--ink); }
  .hero__stage { position: sticky; top: 0; height: 100svh; overflow: hidden; }
  .hero__poster img, .hero__canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero__poster img { object-fit: cover; }
  .hero__canvas { opacity: 0; }
  .hero.is-live .hero__canvas { opacity: 1; }
  .hero.is-live .hero__poster { visibility: hidden; }

  /* ---------- titulares ---------- */
  .beat {
    position: absolute; z-index: 3; width: min(560px, 40vw);
    visibility: hidden; text-shadow: 0 2px 24px rgba(10, 10, 11, 0.9);
  }
  .beat::before { /* sombra suave detrás del texto para leerlo sobre cualquier frame */
    content: ''; position: absolute; inset: -18% -22%; z-index: -1; pointer-events: none;
    background: radial-gradient(closest-side, rgba(10, 10, 11, 0.78), rgba(10, 10, 11, 0));
  }
  .beat--intro { visibility: visible; }
  .beat h1 { font-size: clamp(34px, 5.2vw, 66px); font-weight: 900; margin-top: 14px; }
  .beat__num { margin: 0 0 14px; font-family: var(--font-display); font-weight: 800; font-size: 14px; letter-spacing: 0.2em; color: var(--red); }
  .beat__num span { color: var(--muted-2); }
  .beat__title { margin-top: 10px; font-weight: 900; font-size: clamp(48px, 7.4vw, 112px); line-height: 0.92; letter-spacing: -0.035em; }
  .beat__desc { margin: 18px 0 0; color: #cfcbc2; font-size: clamp(16px, 1.35vw, 19px); line-height: 1.55; max-width: 28em; }
  .beat__dates { margin: 10px 0 22px; font-family: var(--font-display); font-weight: 800; font-size: clamp(26px, 3vw, 40px); letter-spacing: -0.01em; }
  .beat__dates span { color: var(--gold); padding: 0 0.2em; }
  .beat__ctas { display: flex; flex-wrap: wrap; gap: 12px; }

  /* Posiciones en escritorio */
  .beat[data-d='l'] { left: var(--gutter); top: 50%; translate: 0 -50%; }
  .beat[data-d='r'] { right: var(--gutter); top: 50%; translate: 0 -50%; }
  .beat[data-d='tl'] { left: var(--gutter); top: 15svh; }
  .beat[data-d='bl'] { left: var(--gutter); bottom: clamp(28px, 8svh, 80px); }
  .beat[data-d='br'] { right: var(--gutter); bottom: clamp(28px, 8svh, 80px); text-align: right; }
  .beat[data-d='br'] .beat__desc { margin-left: auto; }

  /* ---------- etiquetas ancladas ---------- */
  .hero__tags { position: absolute; inset: 0; z-index: 2; pointer-events: none; }
  .tag { position: absolute; left: 0; top: 0; visibility: hidden; will-change: transform; }
  .tag.is-off .tag__inner { display: none; }
  .tag__dot {
    position: absolute; left: -7px; top: -7px; width: 14px; height: 14px; border-radius: 50%;
    background: var(--gold-hi); box-shadow: 0 0 0 4px rgba(212, 166, 42, 0.25), 0 0 18px 4px rgba(244, 217, 126, 0.55);
  }
  .tag__dot::after {
    content: ''; position: absolute; inset: -10px; border-radius: 50%; border: 1px solid var(--gold);
    animation: ping 1.8s ease-out infinite;
  }
  @keyframes ping { from { transform: scale(0.4); opacity: 1; } to { transform: scale(1.6); opacity: 0; } }
  .tag__line { position: absolute; left: 0; top: 0; height: 1px; background: linear-gradient(90deg, var(--gold-hi), rgba(212, 166, 42, 0.5)); transform-origin: 0 0; }
  .tag__box {
    position: absolute; display: grid; gap: 2px; white-space: nowrap;
    padding: 10px 14px; border-radius: 10px; border: 1px solid rgba(212, 166, 42, 0.45);
    background: rgba(10, 10, 11, 0.78); backdrop-filter: blur(6px);
    box-shadow: 0 12px 30px -12px rgba(0, 0, 0, 0.8);
  }
  .tag__box strong { font-family: var(--font-display); font-weight: 800; font-size: 19px; letter-spacing: -0.01em; }
  .tag__sub { font-size: 14px; color: var(--muted); font-variant-numeric: tabular-nums; }
  .tag[data-sub-at] .tag__sub { display: none; }
  .tag[data-sub-at].has-sub .tag__sub { display: block; color: var(--gold-hi); }

  .hero__hint {
    position: absolute; right: var(--gutter); bottom: clamp(28px, 8svh, 80px); margin: 0; z-index: 3;
    display: flex; align-items: center; gap: 10px;
    font-family: var(--font-display); font-weight: 700; font-size: 11px; letter-spacing: 0.24em; text-transform: uppercase; color: var(--muted);
  }
  .hero__hint span { width: 1px; height: 36px; background: linear-gradient(180deg, transparent, var(--gold)); animation: hint 1.8s ease-in-out infinite; }
  @keyframes hint { 0%, 100% { transform: scaleY(0.4); transform-origin: top; } 50% { transform: scaleY(1); transform-origin: top; } }

  /* ---------- vertical (móvil): titulares arriba o abajo, la acción en el centro ---------- */
  @media (max-aspect-ratio: 9/10) and (max-width: 899px) {
    .hero { height: 760svh; }
    .beat { left: var(--gutter) !important; right: var(--gutter) !important; width: auto; translate: none !important; text-align: left !important; }
    .beat[data-m='top'] { top: 76px; bottom: auto; }
    .beat[data-m='bottom'] { top: auto; bottom: max(24px, env(safe-area-inset-bottom)); }
    .beat .beat__desc { margin-left: 0 !important; }
    .beat__title { font-size: clamp(44px, 13vw, 64px); }
    .beat__num { margin-bottom: 8px; }
    .beat__desc { margin-top: 10px; font-size: 15px; }
    .beat__ctas .btn { flex: 1 1 100%; }
    .hero__hint { display: none; }
    .tag__box { padding: 7px 10px; border-radius: 8px; }
    .tag__box strong { font-size: 14px; }
    .tag__sub { font-size: 12px; }
  }

  /* ---------- sin animación: una sola pantalla con el frame final, el titular y los botones ---------- */
  @media (prefers-reduced-motion: reduce) {
    .hero { height: auto; }
    .hero__stage { position: relative; height: 100svh; min-height: 560px; display: flex; flex-direction: column; justify-content: flex-end; gap: 26px; padding: 0 var(--gutter) clamp(28px, 8svh, 80px); }
    .hero__canvas, .hero__tags, .hero__hint, .beat[data-at] { display: none; }
    .hero__poster img { object-position: 0% 50%; } /* desplaza el escudo a la derecha para dejar sitio al texto */
    .beat--intro, .beat--final { position: relative; inset: auto !important; translate: none !important; visibility: visible; width: min(520px, 32vw); }
    .beat h1 { font-size: clamp(30px, 3.6vw, 50px); }
  }
  @media (prefers-reduced-motion: reduce) and (max-aspect-ratio: 9/10) and (max-width: 899px) {
    .hero__stage { height: auto; min-height: 0; padding: 0 0 48px; }
    .hero__poster img { position: relative; height: auto; aspect-ratio: 600 / 900; object-fit: cover; object-position: 50% 0; }
    .beat--intro, .beat--final { width: auto; margin: 0 var(--gutter); }
  }
</style>
