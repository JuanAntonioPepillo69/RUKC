{
  "name": "rukc-web",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "hero:render": "node tools/hero/render.mjs",
    "hero:encode": "node tools/hero/encode.mjs",
    "test": "node --test \"tests/**/*.test.ts\"",
    "reglamento": "node tools/reglamento/convert.mjs",
    "db:migrar": "node --env-file-if-exists=.env db/migrar.mjs",
    "db:sembrar": "node --env-file-if-exists=.env db/sembrar.mjs",
    "db:test": "node --env-file-if-exists=.env --test --test-concurrency=1 db/tests/esquema.test.mjs db/tests/flujo-web.test.mjs db/tests/panel-login.test.mjs db/tests/panel.test.mjs db/tests/onboarding.test.mjs db/tests/feedback.test.mjs db/tests/operacion.test.mjs",
    "db:crear-admin": "node --env-file-if-exists=.env db/crear-admin.mjs",
    "db:documentos-prueba": "node --env-file-if-exists=.env db/documentos-prueba.mjs",
    "db:documentos": "node --env-file-if-exists=.env db/documentos-reglamento.mjs",
    "db:restaurar": "node --env-file-if-exists=.env db/restaurar-copia.mjs",
    "db:comprobar": "node --env-file-if-exists=.env.produccion db/comprobar-produccion.mjs",
    "db:importar-stripe": "node --env-file-if-exists=.env.produccion db/importar-stripe.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@neondatabase/serverless": "1.2.0",
    "@vercel/blob": "2.8.2",
    "astro": "7.3.5",
    "better-auth": "1.7.10",
    "exceljs": "4.4.0",
    "gsap": "3.15.0",
    "jszip": "3.10.2",
    "lenis": "1.3.26",
    "qrcode": "1.5.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "mammoth": "1.13.0",
    "playwright": "1.63.0",
    "sharp": "0.35.5",
    "three": "0.186.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "engines": {
    "node": ">=22"
  }
}
